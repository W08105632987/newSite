# ============================================
# MONIEKING - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# NEVER commit .env to Git!
# ============================================

# Email Configuration (Gmail)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password

# ============================================
# HOW TO GET GMAIL APP PASSWORD:
# ============================================
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification if not already enabled
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Select "Mail" and "Other (Custom name)"
# 5. Enter "MonieKing Contact Form"
# 6. Click "Generate"
# 7. Copy the 16-character password and paste it above
# ============================================

# Alternative: Use SendGrid (Recommended for Production)
# Get free API key at https://sendgrid.com (100 emails/day free)
# SENDGRID_API_KEY=your-sendgrid-api-key